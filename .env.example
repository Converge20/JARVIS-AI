# Server only. Your existing Codespaces secret provides GROQ_API_KEY.
# Never put credentials in VITE_* variables, browser code, logs, or Git.
GROQ_API_KEY=
GROQ_ENABLED=false
GROQ_MODEL=openai/gpt-oss-20b
AXIOM_ASSISTANT_NAME=AXIOM
API_PORT=3001
AXIOM_MAX_REQUESTS_PER_MINUTE=3
AXIOM_MAX_API_CALLS_PER_MINUTE=6
# Hard cap per server process. A task-tool conversation can use two calls.
AXIOM_MAX_API_CALLS=100
# Includes reasoning tokens. Input bytes include instructions, tools and task data.
AXIOM_MAX_OUTPUT_TOKENS=1024
AXIOM_MAX_INPUT_BYTES=12000
# Estimated input tokens plus reserved output, not Groq's actual tokenizer.
AXIOM_MAX_TOKENS_PER_MINUTE=6000
# Codespaces HTTPS origin / Vite hostname are derived automatically from trusted metadata.
# Optional extra exact HTTPS origin for a custom preview; never use a wildcard.
# AXIOM_ALLOWED_ORIGIN=https://your-private-preview.app.github.dev
# AXIOM_WEB_PORT=5173  # Usually inferred from npm run dev -- --port 5173
# Old OPENAI_* configuration is ignored. Browser voice is opt-in; no speech API key is needed.
