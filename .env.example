# Server only. Never use VITE_ prefixes for secrets. Do not commit .env.
OPENAI_API_KEY=
# Leave false until you approve usage of your own OpenAI project.
OPENAI_ENABLED=false
OPENAI_MODEL=gpt-4.1-mini
AXIOM_ASSISTANT_NAME=AXIOM
API_PORT=3001
AXIOM_MAX_REQUESTS_PER_MINUTE=6
# Hard cap on SDK calls per server process (tool requests can use two calls).
AXIOM_MAX_API_CALLS=100
AXIOM_MAX_OUTPUT_TOKENS=800
# For a trusted HTTPS/private forwarded preview, set its exact origin (no trailing slash).
# AXIOM_ALLOWED_ORIGIN=https://your-private-preview.app.github.dev
# Future voice architecture only: no speech API routes or microphone access in Phase 3.
